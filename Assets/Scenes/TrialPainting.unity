  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nRen\xE9 Magritte's \"Architecture au clair de lune\" (Architecture in
    Moonlight) depicts a surreal scene of a classical architecture, specifically
    a white staircase leading to a platform with a closed door, set against a deep
    blue, moonlit sky. The painting, created in 1956, is a key example of Magritte's
    surrealist style, often exploring themes of reality, representation, and the
    unexpected placement of familiar objects in unfamiliar contexts. \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
